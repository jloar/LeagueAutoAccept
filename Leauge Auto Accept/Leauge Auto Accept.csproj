<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>Leauge_Auto_Accept.Program</StartupObject>
    <AssemblyName>League Auto Accept</AssemblyName>
    <RootNamespace>Leauge_Auto_Accept</RootNamespace>
    <Version>3.8</Version>
    <Company />
    <Product />
    <Authors>Artem</Authors>
    <Title>League Auto Accept</Title>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
    <PackageReference Include="NLog" Version="6.0.4" />
    <PackageReference Include="RestSharp" Version="112.1.0" />
    <PackageReference Include="System.Management" Version="4.7.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
