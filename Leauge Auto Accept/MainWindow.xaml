<Window x:Class="Leauge_Auto_Accept.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="League Auto Accept" Icon="pack://application:,,,/icon.ico"
        Width="880" Height="980" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="14" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" FontSize="13" VerticalAlignment="Center" Margin="0,0,22,0" />
                <TextBlock x:Name="AutoAcceptLabel" FontSize="13" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,9,0" />
                <ToggleButton x:Name="AutoAcceptToggle" Style="{StaticResource Switch}" Checked="AutoAcceptToggle_Changed" Unchecked="AutoAcceptToggle_Changed" />
            </StackPanel>
            <TextBlock Text="League Auto Accept" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Gold}" VerticalAlignment="Center" />
        </DockPanel>

        <Border x:Name="Banner" Grid.Row="1" Visibility="Collapsed" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                CornerRadius="8" Padding="12,8" Margin="0,0,0,12">
            <TextBlock x:Name="BannerText" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource Gold}" />
        </Border>

        <ContentControl x:Name="PageHost" Grid.Row="2" Focusable="False" />

        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="VersionText" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource Dim}" VerticalAlignment="Center" />
            <StackPanel x:Name="NavBar" Orientation="Horizontal">
                <Button x:Name="NavSettings" Style="{StaticResource LinkButton}" Click="NavSettings_Click" Margin="0,0,16,0" />
                <Button x:Name="NavArena" Style="{StaticResource LinkButton}" Click="NavArena_Click" Margin="0,0,16,0" />
                <Button x:Name="NavChat" Style="{StaticResource LinkButton}" Click="NavChat_Click" Margin="0,0,16,0" />
                <Button x:Name="NavInfo" Style="{StaticResource LinkButton}" Click="NavInfo_Click" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
